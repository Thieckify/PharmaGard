# Modèle du fichier de secrets. Copiez-le en ".env" dans le dossier backend, puis remplacez les
# valeurs. Le fichier .env n'est jamais versionné : ne jamais y toucher dans le .env.example.

# Mot de passe de l'utilisateur PostgreSQL (évitez le caractère \ dans ce mot de passe)
DB_PASSWORD=remplacez-par-votre-mot-de-passe-postgresql

# Clé secrète de signature des jetons de connexion : au moins 32 caractères aléatoires,
# différente dans chaque environnement. Voir le README pour en générer une.
JWT_SECRET=remplacez-par-une-valeur-aleatoire-d-au-moins-32-caracteres

# Facultatif : valeurs par défaut entre parenthèses
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=pharmagarde_db
# DB_USERNAME=postgres
# JWT_EXPIRATION_MS=86400000
# DDL_AUTO=validate